{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Aarkam": {
    "BaseDirectory": "aarkam_metadata",
    "UnsafeSkipCertValidation": "true",
    "Storage": {
      "Transport": {
        "Mode": "Auto",
        "SlotSizeBytes": 4194304,
        "SlotCount": 256,
        "DeviceName": null,
        "Port": 1,
        "GidIndex": 0,
        "EnableHugePages": true,
        "CircuitBreakerFailureThreshold": 3
      }
    }
  },
  "Rokka": {
    "DefaultStoragePolicy": "4+2",
    "Transcoder": {
      "Enabled": true,
      "ScanIntervalSeconds": 60,
      "TargetPolicy": "4+2",
      "MaxBytesPerSecond": 40000000,
      "ReclaimOriginalReplicas": true
    }
  },
  "PeerCoordinators": [],
  "StorageNodes": {
    "N-1": {
      "Address": "https://localhost:57775",
      "IntId": 1
    }
  },
  "Health": {
    "HeartbeatTimeoutSeconds": 30,
    "ScanIntervalSeconds": 5,
    "MinAvailableBytesThreshold": 1073741824
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:57774",
        "Protocols": "Http1AndHttp2"
      },
      "gRPC-Http": {
        "Url": "http://0.0.0.0:7774",
        "Protocols": "Http2"
      }
    }
  }
}
