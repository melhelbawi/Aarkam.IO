{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Aarkam": {
    "BaseDirectory": "aarkam_metadata_dev",
    "UnsafeSkipCertValidation": true
  },
