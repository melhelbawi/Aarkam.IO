{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HangfireConnection": "Server=.;Database=AarkamHFDb;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True"
  },
  "AppName": "Aarkam",
  "SerilogSettings": {
    "ApplicationName": "Aarkam.Logging",
    "UseFileSink": true,
    "UseSqlServerSink": false,
    "UseSeqSink": false,
    "SeqUrl": "http://localhost:5341/q/#/",
    "MinimumLevel": "Information"
  },
  "SqlServerConfiguration": {
    "DatabaseName": "AarkamDb",
    "ServerName": ".",
    "IsIntegratedSecurity": true,
    "UserID": "",
    "Password": "",
    "UseEncryption": true,
    "TrustServerCertificate": true
  },
  "JwtTokenOptions": {
    "Issuer": "https://localhost:57771/",
    "Audience": "Aarkam System",
    "AccessTokenSecretKey": "",
    "RefreshTokenSecretKey": "",
    "AccessTokenExpirationInMinutes": 60,
    "RefreshTokenExpirationInMinutes": 120
  },
  "Certificates": {
    "SigningCertificatePath": "",
    "SigningCertificatePassword": ""
  },
  "Cluster": {
    "Mtls": {
      "Enabled": false,
      "ClientCertificatePath": "",
      "ClientCertificatePassword": "",
      "RootCaCertificatePath": ""
    }
  },
  "KraamStorage": {
    "IsCDNEnabled": true,
    "CDNRoute": "/Aarkam-cdn"
  },
  "CacheProvider": "Redis", // InMemory , Redis
  "Cache": {
    "Provider": 0,
    "Memory": {
      "SizeLimit": 1024,
      "ExpirationScanFrequency": 5,
      "CompactionPercentage": 0.2
    }
  },
  "KSAFeatures": {
    "IsOnlySupportedCountry": true
  },
  "NodeAgent": {
    "ApiKey": ""
  },
  "Rokka": {
    "CoordinatorAddress": "https://localhost:57774"
  },
  "Abodi": {
    "ServerUrl": "https://localhost:57776",
    "TelemetryIntervalSeconds": 10,
    "HeartbeatIntervalSeconds": 15
  },
  "Aarkam": {
    "GatewayAddress": "https://localhost:57772",
    "MasterKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:57771",
      "https://localhost:57771/*",
      "http://localhost:7771",
      "http://localhost:7771/*",
      "https://localhost:57772",
      "http://localhost:7772",
      "https://localhost:57773",
      "http://localhost:7773"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:57771",
        "Protocols": "Http1AndHttp2"
      },
      "Http": {
        "Url": "http://0.0.0.0:7771",
        "Protocols": "Http1"
      }
    }
  }
}